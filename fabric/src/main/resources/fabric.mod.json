{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contributors": [
    "Everyone in waccyy's Fantasia Discord server"
  ],
  "contact": {
    "issues": "https://github.com/phuccom000/Overgeared-1.20.1/issues",
    "sources": "https://github.com/phuccom000/Overgeared-1.20.1"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
