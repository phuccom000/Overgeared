  "entrypoints": {
    "main": [
      "net.stirdrem.overgeared.fabric.OvergearedFabric"
    ],
    "client": [
      "net.stirdrem.overgeared.fabric.client.OvergearedFabricClient"
    ],
    "jei_mod_plugin": [
      "net.stirdrem.overgeared.compat.jei.JEIOvergearedModPlugin"
    ]
  },
