{
  "comment": "Permission rules linen init wrote; it uses this list to remove its own rules that are no longer needed.",
  "permissions": {
    "allow": [
      "mcp__linen",
      "Bash(./gradlew *)",
      "PowerShell(./gradlew *)",
      "PowerShell(.\\gradlew *)",
      "PowerShell(.\\gradlew.bat *)",
      "Bash(git status *)",
      "PowerShell(git status *)",
      "Bash(git diff *)",
      "PowerShell(git diff *)",
      "Bash(git log *)",
      "PowerShell(git log *)"
    ],
    "ask": [
      "Edit(/linen.toml)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr create *)"
    ],
    "deny": [
      "Edit(/src/generated/**)",
      "Edit(/.linen/state/**)",
      "Edit(/.linen/cache/**)",
      "Edit(/.linen/claude-context.md)",
      "Edit(/.linen/claude-rules.md)",
      "Edit(/.mceditor/**)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push * --force*)",
      "PowerShell(git push * --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git push * -f*)",
      "PowerShell(git push * -f*)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rmdir *)",
      "PowerShell(Remove-Item * -r*)",
      "mcp__linen__guard",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.mcp.json)",
      "Bash(gh release create *)",
      "PowerShell(gh release create *)",
      "Bash(gh release upload *)",
      "PowerShell(gh release upload *)",
      "Bash(./gradlew *modrinth*)",
      "PowerShell(./gradlew *modrinth*)",
      "Bash(./gradlew *curseforge*)",
      "PowerShell(./gradlew *curseforge*)",
      "Bash(./gradlew *publishMods*)",
      "PowerShell(./gradlew *publishMods*)",
      "PowerShell(.\\gradlew *modrinth*)",
      "PowerShell(.\\gradlew *curseforge*)",
      "PowerShell(.\\gradlew *publishMods*)"
    ],
    "additionalDirectories": []
  }
}
